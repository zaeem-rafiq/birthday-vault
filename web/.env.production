# Public ids for the public build on NEAR testnet. `next build` reads this file, but any value
# already set in the environment wins, so Render settings and the end-to-end sandbox values
# override these. The hub keys are never in this file: set NEXT_PUBLIC_HUB_KEYS in Render.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_COLLECTION_ID=g2.birthday-vault-zr1109.testnet
NEXT_PUBLIC_HUB_ID=hub.birthday-vault-zr1109.testnet
NEXT_PUBLIC_USDC_ID=tusdc.birthday-vault-zr1109.testnet
